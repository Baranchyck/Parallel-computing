<Window x:Class="ThreeThreads.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Form1" Height="410" Width="480"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Canvas x:Name="canvas1" Grid.Row="0" Grid.Column="0" Width="100" Height="270" Background="LightGray"/>
        <Canvas x:Name="canvas2" Grid.Row="0" Grid.Column="1" Width="100" Height="270" Background="LightGray"/>
        <Canvas x:Name="canvas3" Grid.Row="0" Grid.Column="2" Width="100" Height="270" Background="LightGray"/>

        <TextBlock x:Name="lbl1" Grid.Row="1" Grid.Column="0" Text="Простій: 0" HorizontalAlignment="Center" Margin="0,5"/>
        <TextBlock x:Name="lbl2" Grid.Row="1" Grid.Column="1" Text="Простій: 0" HorizontalAlignment="Center" Margin="0,5"/>
        <TextBlock x:Name="lbl3" Grid.Row="1" Grid.Column="2" Text="Простій: 0" HorizontalAlignment="Center" Margin="0,5"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="btnStart" Content="Start" Width="80" Height="25" Margin="5" Click="BtnStart_Click"/>
            <Button x:Name="btnPause" Content="Pause" Width="80" Height="25" Margin="5" IsEnabled="False" Click="BtnPause_Click"/>
            <CheckBox x:Name="chkRandom" Content="Random" IsChecked="True" VerticalAlignment="Center" Margin="10,0"/>
            <Button x:Name="btnExit" Content="Exit" Width="80" Height="25" Margin="5" Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>
